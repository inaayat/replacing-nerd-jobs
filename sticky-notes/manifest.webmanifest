{
  "name": "Sticky Notes",
  "short_name": "Stickies",
  "id": "/sticky-notes/",
  "description": "A board you dump onto and think on, with a memory that keeps everything.",
  "start_url": "/sticky-notes/",
  "scope": "/sticky-notes/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "orientation": "any",
  "background_color": "#faf3e3",
  "theme_color": "#faf3e3",
  "categories": ["productivity", "utilities"],
  "share_target": {
    "action": "/sticky-notes/?share=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "New note",
      "short_name": "New note",
      "url": "/sticky-notes/?new=1",
      "icons": [
        {
          "src": "/sticky-notes/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "/sticky-notes/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/sticky-notes/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/sticky-notes/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
