{
  "_comment": "Question templates for Plot Points. Each entry is an ordinary spec that round-trips through normalizeSpec(), so a question can never express anything the builder can't. `{person}` in `question` is filled from `slot`; questions without a slot are fixed. `slot.pool` picks which seed list Surprise me draws from.",
  "groups": [
    { "id": "collaboration", "label": "Who works with whom", "accent": "orange" },
    { "id": "taste", "label": "Who makes it good", "accent": "teal" },
    { "id": "money", "label": "Where the money goes", "accent": "red" },
    { "id": "time", "label": "How things changed", "accent": "peach" }
  ],
  "questions": [
    {
      "id": "repeat-cast",
      "group": "collaboration",
      "question": "Who does {person} keep casting?",
      "blurb": "Actors ranked by how many of their films they turn up in.",
      "slot": { "type": "person", "pool": "directors", "default": { "tmdb_id": 525, "name": "Christopher Nolan" } },
      "spec": {
        "scope": { "type": "person-directed" },
        "group_by": "actor",
        "metric": { "agg": "count" },
        "min_films": 2,
        "sort": "desc",
        "limit": 25,
        "depth": 60
      }
    },
    {
      "id": "repertory",
      "group": "collaboration",
      "question": "Which co-stars keep turning up together in {person}'s films?",
      "blurb": "Pairs of actors, ranked by films shared — the repertory company.",
      "slot": { "type": "person", "pool": "directors", "default": { "tmdb_id": 5655, "name": "Wes Anderson" } },
      "spec": {
        "scope": { "type": "person-directed" },
        "group_by": "actor+actor",
        "metric": { "agg": "count" },
        "min_films": 2,
        "sort": "desc",
        "limit": 25,
        "depth": 60
      }
    },
    {
      "id": "costars",
