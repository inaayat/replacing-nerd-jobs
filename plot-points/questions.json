      "spec": {
        "scope": { "type": "person-acted" },
        "group_by": "actor",
        "metric": { "agg": "count" },
        "exclude_subject": true,
        "min_films": 2,
        "sort": "desc",
        "limit": 25,
        "depth": 200
      }
    },
